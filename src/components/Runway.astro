---
import Icon from './Icon.astro';
import { cta } from '../data/site';
---

<section class="section section--surface runway" id="runway" aria-labelledby="runway-title">
  <div class="container runway-grid">
    <div class="runway-copy">
      <p class="eyebrow">Faça a conta</p>
      <h2 id="runway-title" data-split>Em que mês o seu caixa acaba?</h2>
      <p class="lead" data-reveal>
        É a conta mais importante de uma empresa, e quase ninguém sabe de cabeça. Duas perguntas, nenhum cadastro.
      </p>

      <form class="runway-form" data-runway data-reveal novalidate>
        <label class="field">
          <span>Quanto você tem em caixa hoje</span>
          <span class="field-box">
            <span aria-hidden="true">R$</span>
            <input name="cash" inputmode="numeric" autocomplete="off" value="850.000" aria-describedby="runway-fine" />
          </span>
        </label>
        <label class="field">
          <span>Quanto sai a mais do que entra, por mês</span>
          <span class="field-box">
            <span aria-hidden="true">R$</span>
            <input name="burn" inputmode="numeric" autocomplete="off" value="190.000" aria-describedby="runway-fine" />
          </span>
        </label>
        <p class="fine" id="runway-fine">Conta: caixa ÷ queima mensal. O que você digita não sai do seu navegador.</p>
      </form>
    </div>

    <div class="runway-result" data-reveal data-spotlight aria-live="polite">
      <p class="kicker" data-runway-kicker>Seu fôlego</p>
      <p class="runway-figure"><span data-runway-value>4,5</span> <span class="runway-unit" data-runway-unit>meses</span></p>
      <p class="runway-sentence" data-runway-sentence>No ritmo de hoje, o caixa acaba em fevereiro de 2027.</p>

      <div class="horizon" aria-hidden="true">
        <div class="horizon-ends"><span>18 meses antes</span><span>Caixa zero</span></div>
        <div class="horizon-track">
          <span class="horizon-marker" data-runway-marker><span>Você está aqui</span></span>
        </div>
      </div>

      <p class="runway-next" data-runway-next>
        A crise avisa, em média, 18 meses antes. Com 4,5 meses de caixa, o aviso já passou: agora é plano.
      </p>
      <a class="btn btn-primary" href={cta.primary.href} data-magnetic>{cta.primary.label} <Icon name="arrow" /></a>
      <p class="fine">O diagnóstico refaz essa conta com os seus dados reais e mostra de onde vem cada número.</p>
    </div>
  </div>
</section>

<style>
  .runway-grid { display: grid; gap: 2.5rem; align-items: start; }
  .runway-copy { display: grid; gap: 1.25rem; }
  .runway-copy .eyebrow { margin-bottom: 0; }

  .runway-form { display: grid; gap: 1.1rem; margin-top: 0.75rem; }
  .field { display: grid; gap: 0.5rem; font-weight: 500; }
  .field-box {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0 1.1rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--r-lg);
    background: var(--bg-base);
    font: 500 1.375rem/1 var(--font-mono);
    color: var(--text-tertiary);
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .field-box:focus-within { border-color: var(--accent); box-shadow: 0 0 0 4px var(--accent-subtle); }
  .field input {
    width: 100%;
    min-height: 60px;
    border: 0;
    outline: 0;
    background: none;
    color: var(--text-primary);
    font-variant-numeric: tabular-nums;
  }
  .fine { font-size: 0.875rem; color: var(--text-tertiary); }

  .runway-result {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
    padding: clamp(1.5rem, 4vw, 2.75rem);
    border: 1px solid var(--border-strong);
    border-radius: var(--r-2xl);
    background: var(--bg-base);
    box-shadow: var(--shadow);
  }
  .runway-figure {
    font-size: clamp(3.75rem, 11vw, 7rem);
    font-weight: 700;
    line-height: 0.9;
    letter-spacing: -0.05em;
    font-variant-numeric: tabular-nums;
    color: var(--sev, var(--text-primary));
    transition: color 0.5s;
  }
  .runway-unit { font-size: 0.32em; letter-spacing: -0.02em; color: var(--text-primary); }
  .runway-sentence { font-size: clamp(1.125rem, 1.8vw, 1.375rem); font-weight: 500; line-height: 1.35; }
  .runway-next { color: var(--text-secondary); }

  .horizon { width: 100%; padding-block: 0.25rem 2.25rem; }
  .horizon-ends {
    display: flex;
    justify-content: space-between;
    margin-bottom: 0.75rem;
    font: 500 0.75rem/1 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-tertiary);
  }
  .horizon-ends span:last-child { color: var(--sev-intervencao); }
  .horizon-track { position: relative; height: 4px; border-radius: 4px; background: var(--sev-line); }
  .horizon-marker {
    position: absolute;
    top: 50%;
    left: var(--pos, 75%);
    width: 18px;
    height: 18px;
    margin: -9px 0 0 -9px;
    border: 3px solid var(--bg-base);
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.5), 0 0 22px 4px rgb(255 255 255 / 0.35);
    transition: left 0.9s var(--ease-out);
  }
  .horizon-marker span {
    position: absolute;
    top: 26px;
    left: 50%;
    translate: var(--label-shift, -50%) 0;
    font: 500 0.75rem/1 var(--font-mono);
    letter-spacing: 0.06em;
    white-space: nowrap;
    color: var(--text-primary);
  }

  @media (min-width: 960px) {
    .runway-grid { grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: 5rem; }
  }
</style>

<script>
  import { gsap, reducedMotion } from '../scripts/motion';

  const HORIZON = 18;
  const form = document.querySelector<HTMLFormElement>('[data-runway]');

  if (form) {
    const cash = form.elements.namedItem('cash') as HTMLInputElement;
    const burn = form.elements.namedItem('burn') as HTMLInputElement;
    const result = document.querySelector<HTMLElement>('.runway-result')!;
    const value = result.querySelector<HTMLElement>('[data-runway-value]')!;
    const unit = result.querySelector<HTMLElement>('[data-runway-unit]')!;
    const kicker = result.querySelector<HTMLElement>('[data-runway-kicker]')!;
    const sentence = result.querySelector<HTMLElement>('[data-runway-sentence]')!;
    const next = result.querySelector<HTMLElement>('[data-runway-next]')!;
    const marker = result.querySelector<HTMLElement>('[data-runway-marker]')!;

    const number = new Intl.NumberFormat('pt-BR');
    const decimal = new Intl.NumberFormat('pt-BR', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
    const monthYear = new Intl.DateTimeFormat('pt-BR', { month: 'long', year: 'numeric' });
    const parse = (input: HTMLInputElement) => Number(input.value.replace(/\D/g, '')) || 0;
    const shown = { months: 4.5 };

    const setFigure = (months: number, capped: boolean) => {
      const text = () => (capped ? '18+' : decimal.format(shown.months));
      if (reducedMotion) {
        shown.months = months;
        value.textContent = text();
        return;
      }
      gsap.to(shown, { months, duration: 0.8, ease: 'power3.out', onUpdate: () => (value.textContent = text()) });
    };

    const update = () => {
      const cashValue = parse(cash);
      const burnValue = parse(burn);
      result.style.removeProperty('--sev');

      if (!cashValue && !burnValue) return;

      if (burnValue <= 0) {
        kicker.textContent = 'Seu fôlego';
        value.textContent = '∞';
        unit.textContent = '';
        sentence.textContent = 'Você não está queimando caixa.';
        next.textContent = 'É a melhor hora para ligar o radar: quando ainda sobra opção.';
        marker.style.setProperty('--pos', '0%');
        marker.style.setProperty('--label-shift', '0%');
        result.style.setProperty('--sev', 'var(--sev-estavel)');
        return;
      }

      const months = cashValue / burnValue;
      const capped = months > HORIZON;
      const position = Math.min(1, Math.max(0, 1 - months / HORIZON));
      const end = new Date();
      end.setMonth(end.getMonth() + Math.floor(months));

      kicker.textContent = 'Seu fôlego';
      unit.textContent = months >= 1.95 || capped ? 'meses' : 'mês';
      setFigure(Math.min(months, HORIZON), capped);
      marker.style.setProperty('--pos', `${position * 100}%`);
      // O rótulo não pode sair da trilha nas pontas.
      marker.style.setProperty('--label-shift', position < 0.14 ? '0%' : position > 0.86 ? '-100%' : '-50%');

      if (capped) {
        sentence.textContent = 'Mais de 18 meses de fôlego.';
        next.textContent = 'Você está antes do aviso. É aqui que prevenir custa menos.';
        result.style.setProperty('--sev', 'var(--sev-estavel)');
      } else {
        sentence.textContent = `No ritmo de hoje, o caixa acaba em ${monthYear.format(end)}.`;
        next.textContent =
          months < 6
            ? `A crise avisa, em média, 18 meses antes. Com ${decimal.format(months)} ${months >= 1.95 ? 'meses' : 'mês'} de caixa, o aviso já passou: agora é plano.`
            : 'A crise avisa, em média, 18 meses antes. Você está dentro da janela: ainda há caixa e opções.';
        result.style.setProperty(
          '--sev',
          months < 3 ? 'var(--sev-intervencao)' : months < 6 ? 'var(--sev-critico)' : months < 12 ? 'var(--sev-monitor)' : 'var(--sev-estavel)',
        );
      }
    };

    [cash, burn].forEach((input) => {
      input.addEventListener('input', () => {
        const digits = input.value.replace(/\D/g, '').slice(0, 12);
        input.value = digits ? number.format(Number(digits)) : '';
        update();
      });
    });
    form.addEventListener('submit', (event) => event.preventDefault());
    update();
  }
</script>
