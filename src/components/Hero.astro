---
import PageHero from './PageHero.astro';
import { cta, proof, radarSignals } from '../data/site';
---

<PageHero
  tall
  eyebrow="A primeira turntech do planeta"
  lead="Ela avisa. Em média, dezoito meses antes. O fornecedor que passa a pedir à vista, o limite que encolhe, a folha que atrasa dois dias. A SECC lê esses avisos dentro da sua empresa e põe um plano de pé enquanto ainda há caixa e opções."
  instrument="radar"
  signals={radarSignals}
  caption="Radar da Crise · demonstração com sinais ilustrativos"
  primary={cta.primary}
  secondary={cta.secondary}
  note={cta.note}
>
  <Fragment slot="title">Nenhuma empresa quebra <span class="accent">do nada</span>.</Fragment>
  <dl class="ledger" slot="foot">
    {
      proof.map((item) => (
        <div>
          <dt>{item.label}</dt>
          <dd>
            <span data-count={item.count} data-prefix={item.prefix} data-suffix={item.suffix}>{item.value}</span>
          </dd>
        </div>
      ))
    }
  </dl>
</PageHero>

<style>
  .ledger { display: grid; grid-template-columns: repeat(3, minmax(0, auto)); gap: 1rem 2.5rem; }
  .ledger > div { display: flex; flex-direction: column-reverse; justify-content: flex-end; gap: 0.3rem; }
  .ledger dd {
    font-size: clamp(1.375rem, 5.4vw, 1.875rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .ledger dt { font: 500 0.75rem/1.4 var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-tertiary); }
  @media (max-width: 899px) { .ledger { gap: 1rem; width: 100%; } }
</style>
