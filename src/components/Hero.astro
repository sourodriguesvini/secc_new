---
import Icon from './Icon.astro';
import { cta, proof, radarSignals } from '../data/site';
---

<section class="hero" aria-labelledby="hero-title">
  <canvas class="radar" data-radar data-signals={JSON.stringify(radarSignals)} aria-hidden="true"></canvas>
  <div class="hero-shade" aria-hidden="true"></div>

  <div class="container hero-content">
    <p class="hero-tag" data-reveal><span class="hero-tag-dot" aria-hidden="true"></span>A primeira turntech do planeta</p>
    <h1 id="hero-title" data-split="hero">Nenhuma empresa quebra <span class="accent">do nada</span>.</h1>
    <p class="hero-lead" data-reveal="0.35">
      Ela avisa. Em média, dezoito meses antes. O fornecedor que passa a pedir à vista, o limite que encolhe, a folha que
      atrasa dois dias. A SECC lê esses avisos dentro da sua empresa e põe um plano de pé enquanto ainda há caixa e opções.
    </p>
    <div class="cta-row" data-reveal="0.5">
      <a class="btn btn-primary" href={cta.primary.href} data-magnetic>{cta.primary.label} <Icon name="arrow" /></a>
      <a class="btn btn-ghost" href={cta.secondary.href}>{cta.secondary.label}</a>
    </div>
    <p class="cta-note" data-reveal="0.6">{cta.note}</p>
  </div>

  <div class="container hero-foot" data-reveal="0.8">
    <dl class="ledger">
      {
        proof.map((item) => (
          <div>
            <dt>{item.label}</dt>
            <dd>{item.value}</dd>
          </div>
        ))
      }
    </dl>
    <p class="radar-caption">Radar da Crise · demonstração com sinais ilustrativos</p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: clamp(2rem, 5vh, 3.5rem);
    /* Cabe na primeira dobra junto com a faixa SOS. */
    min-height: min(calc(100svh - var(--sos-h)), 980px);
    margin-top: calc(var(--header-h) * -1);
    padding: calc(var(--header-h) + 2.5rem) 0 2rem;
  }

  .radar {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
  }
  .hero-shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(90deg, var(--bg-base) 0%, rgb(7 8 9 / 0.9) 34%, rgb(7 8 9 / 0) 60%),
      linear-gradient(180deg, rgb(7 8 9 / 0) 70%, var(--bg-base) 100%);
    pointer-events: none;
  }

  .hero-content { display: grid; gap: 1.4rem; justify-items: start; }
  .hero-content h1 { max-width: 14ch; font-size: clamp(2.75rem, 6.2vw, 5.75rem); }
  .hero-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font: 500 0.75rem/1.4 var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-secondary);
  }
  .hero-tag-dot { width: 7px; height: 7px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 12px 2px var(--glow); }
  .hero-lead {
    max-width: 32rem;
    font-size: clamp(1.0625rem, 1.4vw, 1.25rem);
    line-height: 1.5;
    color: rgb(245 247 251 / 0.86);
    text-wrap: pretty;
  }

  .hero-foot {
    display: grid;
    gap: 0.9rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }
  .ledger { display: grid; grid-template-columns: repeat(3, minmax(0, auto)); gap: 1rem 2.5rem; }
  .ledger > div { display: flex; flex-direction: column-reverse; justify-content: flex-end; gap: 0.3rem; }
  .ledger dd { font-size: clamp(1.375rem, 5.4vw, 1.875rem); font-weight: 700; line-height: 1; letter-spacing: -0.02em; white-space: nowrap; }
  .ledger dt { font: 500 0.75rem/1.4 var(--font-mono); letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-tertiary); }
  .radar-caption { font: 400 0.75rem/1.4 var(--font-mono); letter-spacing: 0.04em; color: var(--text-tertiary); }

  @media (max-width: 899px) {
    /* A faixa do radar tem 2 × raio (raio = 26vw, até 130px) mais respiro. */
    .hero { padding-top: calc(var(--header-h) + min(52vw, 260px) + 2.25rem); justify-content: flex-start; }
    .hero-shade { display: none; }
    .ledger { gap: 1rem; width: 100%; }
  }
</style>

<script>
  import { initRadar } from '../scripts/radar';
  import { reducedMotion } from '../scripts/motion';

  const canvas = document.querySelector<HTMLCanvasElement>('[data-radar]');
  if (canvas) {
    initRadar(canvas, JSON.parse(canvas.dataset.signals ?? '[]'), reducedMotion);
  }
</script>
