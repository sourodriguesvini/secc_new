---
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
import segunda from '../assets/segunda.jpg';
import { cta } from '../data/site';
---

<section class="section final" aria-labelledby="final-title">
  <div class="container">
    <div class="final-card" data-reveal>
      <Image
        src={segunda}
        alt="Dono de uma pequena indústria abrindo o portão do galpão ao amanhecer."
        widths={[768, 1280, 1920, 2560]}
        sizes="(min-width: 1240px) 1240px, 100vw"
        class="final-photo"
      />
      <div class="final-shade" aria-hidden="true"></div>
      <p class="final-today" data-today></p>
      <h2 id="final-title" data-split>A crise de segunda não espera a reunião de quinta.</h2>
      <p class="lead">
        Conte à SECC como está a sua empresa e saia com as crises que estão a caminho e o plano para a sua realidade.
      </p>
      <div class="cta-row">
        <a class="btn btn-primary" href={cta.primary.href} data-magnetic>{cta.primary.label} <Icon name="arrow" /></a>
        <a class="btn btn-ghost" href={cta.secondary.href}>{cta.secondary.label}</a>
      </div>
      <p class="cta-note">{cta.note}</p>
    </div>
  </div>
</section>

<style>
  .final-card {
    display: grid;
    gap: 1.5rem;
    justify-items: start;
    padding: clamp(2rem, 6vw, 5.5rem);
    border: 1px solid var(--border-strong);
    border-radius: 32px;
    background: var(--bg-surface);
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }
  .final-card :global(.final-photo) {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 78% center;
  }
  /* O texto mora no escuro do galpão; a luz do portão fica livre à direita. */
  .final-shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(180deg, rgb(7 8 9 / 0.5) 0%, rgb(7 8 9 / 0.86) 45%, rgb(7 8 9 / 0.95) 100%);
  }
  @media (min-width: 900px) {
    .final-shade {
      background: linear-gradient(90deg, rgb(7 8 9 / 0.94) 0%, rgb(7 8 9 / 0.8) 42%, rgb(7 8 9 / 0.12) 72%, rgb(7 8 9 / 0) 100%);
    }
  }
  .final-card h2 { max-width: 15ch; font-size: clamp(2.25rem, 6vw, 5rem); line-height: 0.98; }
  .final-card .lead { max-width: 38rem; }
  .final-today {
    font: 500 0.75rem/1.4 var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }
  .final-today:empty { display: none; }
</style>

<script>
  // O título fala de segunda e quinta; a linha de cima diz que dia é hoje para quem lê.
  const today = document.querySelector<HTMLElement>('[data-today]');
  if (today) {
    const weekday = new Intl.DateTimeFormat('pt-BR', { weekday: 'long' }).format(new Date());
    today.textContent = `Hoje é ${weekday}.`;
  }
</script>
