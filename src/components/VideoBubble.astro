---
// Balão flutuante do filme: um trecho curto roda em miniatura, sem som, para
// mostrar que há algo ali; o filme inteiro só carrega e toca depois do clique.
// Os arquivos são configurados em src/data/site.ts.
import Icon from './Icon.astro';
import { cta, presentationVideo as video } from '../data/site';
---

<div class="vb" data-vb hidden>
  <button type="button" class="vb-open" data-vb-open aria-haspopup="dialog" aria-label={`${video.label}: ${video.hint}`}>
    <span class="vb-face">
      <video src={video.preview} poster={video.previewPoster} muted loop playsinline preload="metadata" disablepictureinpicture data-vb-preview></video>
    </span>
    <span class="vb-label" aria-hidden="true">
      <strong>{video.label}</strong>
      <span><Icon name="play" />{video.hint}</span>
    </span>
  </button>
  <button type="button" class="vb-dismiss" data-vb-dismiss aria-label="Dispensar o filme">
    <Icon name="close" />
  </button>
</div>

<dialog class="vb-dialog" data-vb-dialog aria-labelledby="vb-title">
  <div class="vb-dialog-inner">
    <header>
      <h2 id="vb-title">{video.title}</h2>
      <button type="button" class="vb-close" data-vb-close aria-label="Fechar o filme"><Icon name="close" /></button>
    </header>
    <video src={video.src} poster={video.poster} controls playsinline preload="none" data-vb-player></video>
    <footer>
      <a class="btn btn-primary" href={cta.primary.href}>{cta.primary.label} <Icon name="arrow" /></a>
      <a class="btn btn-ghost" href={cta.secondary.href}>{cta.secondary.label}</a>
    </footer>
  </div>
</dialog>

<style>
  .vb {
    position: fixed;
    right: max(1rem, env(safe-area-inset-right));
    bottom: max(1rem, env(safe-area-inset-bottom));
    z-index: 40;
    animation: vb-in 0.8s var(--ease-out) both;
  }
  @keyframes vb-in {
    from { opacity: 0; transform: translateY(24px) scale(0.9); }
  }

  .vb-open {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.3rem;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    background: rgb(20 23 31 / 0.9);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    box-shadow: var(--shadow);
    text-align: left;
    transition: border-color 0.25s, transform 0.4s var(--ease-out);
  }
  .vb-open:hover { border-color: var(--accent); transform: translateY(-3px); }

  .vb-face {
    position: relative;
    display: block;
    width: 68px;
    height: 68px;
    border-radius: 50%;
    background: var(--bg-base);
    flex: none;
  }
  .vb-face video { width: 100%; height: 100%; border-radius: 50%; object-fit: cover; }
  /* Anel que respira em volta da miniatura: convida sem piscar. */
  .vb-face::after {
    content: '';
    position: absolute;
    inset: -3px;
    border-radius: 50%;
    border: 2px solid var(--accent);
    animation: vb-ring 2.8s ease-out infinite;
    pointer-events: none;
  }
  @keyframes vb-ring {
    0% { opacity: 0.9; transform: scale(1); }
    70%, 100% { opacity: 0; transform: scale(1.22); }
  }

  .vb-label { display: none; padding-right: 1.1rem; line-height: 1.25; }
  .vb-label strong { display: block; font-size: 0.9375rem; font-weight: 600; }
  .vb-label span { display: inline-flex; align-items: center; gap: 0.35rem; font-size: 0.8125rem; color: var(--text-secondary); }
  .vb-label :global(.icon) { width: 0.7rem; height: 0.7rem; color: var(--accent); }

  .vb-dismiss {
    position: absolute;
    top: -8px;
    right: -6px;
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border: 1px solid var(--border-strong);
    border-radius: 50%;
    background: var(--bg-elevated);
    color: var(--text-secondary);
    font-size: 0.75rem;
    opacity: 0;
    transition: opacity 0.2s;
  }
  .vb:hover .vb-dismiss,
  .vb-dismiss:focus-visible { opacity: 1; }
  @media (hover: none) { .vb-dismiss { opacity: 1; } }

  /* O rótulo aparece na chegada e recolhe depois: fica só a miniatura rodando. */
  @media (min-width: 640px) {
    .vb-face { width: 84px; height: 84px; }
    .vb-label { display: block; }
    .vb.is-compact:not(:hover):not(:focus-within) .vb-label { display: none; }
  }

  .vb-dialog {
    width: min(100% - 2rem, 68rem);
    max-height: calc(100dvh - 2rem);
    padding: 0;
    border: 1px solid var(--border-strong);
    border-radius: var(--r-2xl);
    background: var(--bg-elevated);
    color: var(--text-primary);
    box-shadow: var(--shadow);
    overflow: auto;
  }
  .vb-dialog::backdrop { background: rgb(4 5 6 / 0.86); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); }
  .vb-dialog[open] { animation: vb-dialog-in 0.5s var(--ease-out); }
  @keyframes vb-dialog-in {
    from { opacity: 0; transform: translateY(24px) scale(0.97); }
  }
  .vb-dialog-inner { display: grid; gap: 1.1rem; padding: clamp(0.9rem, 2.5vw, 1.5rem); }
  .vb-dialog header { display: flex; align-items: center; justify-content: space-between; gap: 1rem; }
  .vb-dialog h2 { font: 500 0.75rem/1.4 var(--font-mono); letter-spacing: 0.14em; text-transform: uppercase; color: var(--text-secondary); }
  .vb-close {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin: -0.4rem -0.4rem -0.4rem 0;
    border-radius: 50%;
    flex: none;
  }
  .vb-close:hover { background: rgb(255 255 255 / 0.08); }
  .vb-dialog video { width: 100%; aspect-ratio: 16 / 9; border-radius: var(--r-xl); background: #000; }
  .vb-dialog footer { display: flex; flex-wrap: wrap; gap: 0.75rem; }
</style>

<script>
  const bubble = document.querySelector<HTMLElement>('[data-vb]');
  const dialog = document.querySelector<HTMLDialogElement>('[data-vb-dialog]');

  if (bubble && dialog) {
    const preview = bubble.querySelector<HTMLVideoElement>('[data-vb-preview]')!;
    const player = dialog.querySelector<HTMLVideoElement>('[data-vb-player]')!;
    const DISMISSED = 'secc-video-dismissed';
    const dismissed = () => {
      try {
        return sessionStorage.getItem(DISMISSED) === '1';
      } catch {
        return false;
      }
    };
    // Mudo e inline: os navegadores deixam tocar sozinho.
    const playPreview = () => preview.play().catch(() => {});

    // Entra depois que a pessoa já leu o título, para não disputar a primeira impressão.
    const show = () => {
      if (!bubble.hidden || dismissed()) return;
      bubble.hidden = false;
      playPreview();
      window.setTimeout(() => bubble.classList.add('is-compact'), 7000);
    };
    const timer = window.setTimeout(show, 3500);
    window.addEventListener(
      'scroll',
      () => {
        if (window.scrollY > 500) {
          window.clearTimeout(timer);
          show();
        }
      },
      { passive: true },
    );
    // Não gasta bateria com a aba em segundo plano.
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) preview.pause();
      else if (!bubble.hidden && !dialog.open) playPreview();
    });

    bubble.querySelector('[data-vb-open]')!.addEventListener('click', () => {
      preview.pause();
      dialog.showModal();
      // O clique é o gesto que libera o som: o filme começa do início, com áudio.
      player.currentTime = 0;
      player.play().catch(() => {});
    });
    bubble.querySelector('[data-vb-dismiss]')!.addEventListener('click', () => {
      preview.pause();
      bubble.hidden = true;
      try {
        sessionStorage.setItem(DISMISSED, '1');
      } catch {
        /* sem armazenamento: some só nesta página */
      }
    });

    dialog.querySelector('[data-vb-close]')!.addEventListener('click', () => dialog.close());
    // Clique fora do conteúdo fecha, como em qualquer lightbox.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener('close', () => {
      player.pause();
      if (!bubble.hidden) playPreview();
    });
  }
</script>
