---
// Balão flutuante de vídeo: fica no canto, convida sem cobrir nada, e abre o
// vídeo inteiro num diálogo. O vídeo é configurado em src/data/site.ts.
import Icon from './Icon.astro';
import { cta, presentationVideo as video } from '../data/site';
---

<div class="vb" data-vb hidden>
  <button type="button" class="vb-open" data-vb-open aria-haspopup="dialog">
    <span class="vb-face">
      {
        video.src ? (
          <video src={video.src} poster={video.poster || undefined} muted loop playsinline preload="none" data-vb-preview />
        ) : (
          <img src="https://secctech.ai/brand/secc-symbol.png" alt="" width="64" height="64" loading="lazy" />
        )
      }
      <span class="vb-play"><Icon name="play" /></span>
    </span>
    <span class="vb-label">
      <strong>{video.label}</strong>
      <span>Ver o vídeo</span>
    </span>
  </button>
  <button type="button" class="vb-dismiss" data-vb-dismiss aria-label="Dispensar o vídeo de apresentação">
    <Icon name="close" />
  </button>
</div>

<dialog class="vb-dialog" data-vb-dialog aria-labelledby="vb-title">
  <div class="vb-dialog-inner">
    <header>
      <h2 id="vb-title">{video.title}</h2>
      <button type="button" class="vb-close" data-vb-close aria-label="Fechar o vídeo"><Icon name="close" /></button>
    </header>
    {
      video.src ? (
        <video src={video.src} poster={video.poster || undefined} controls playsinline preload="metadata" data-vb-player />
      ) : (
        <div class="vb-placeholder">
          <p class="kicker">Em produção</p>
          <p>O vídeo de apresentação do Estevão entra aqui.</p>
          <p class="vb-hint">Basta apontar o arquivo em <code>src/data/site.ts</code>.</p>
        </div>
      )
    }
    <footer>
      <a class="btn btn-primary" href={cta.primary.href}>{cta.primary.label} <Icon name="arrow" /></a>
      <a class="btn btn-ghost" href={cta.secondary.href}>{cta.secondary.label}</a>
    </footer>
  </div>
</dialog>

<style>
  .vb {
    position: fixed;
    right: max(1rem, env(safe-area-inset-right));
    bottom: max(1rem, env(safe-area-inset-bottom));
    z-index: 40;
    animation: vb-in 0.8s var(--ease-out) both;
  }
  @keyframes vb-in {
    from { opacity: 0; transform: translateY(24px) scale(0.9); }
  }

  .vb-open {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.4rem;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    background: rgb(20 23 31 / 0.9);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    box-shadow: var(--shadow);
    text-align: left;
    transition: border-color 0.25s, transform 0.4s var(--ease-out);
  }
  .vb-open:hover { border-color: var(--accent); transform: translateY(-3px); }

  .vb-face {
    position: relative;
    display: grid;
    place-items: center;
    width: 60px;
    height: 60px;
    border-radius: 50%;
    overflow: hidden;
    background: var(--bg-base);
    flex: none;
  }
  /* Anel que respira: convida sem piscar. */
  .vb-face::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 2px solid var(--accent);
    animation: vb-ring 2.8s ease-out infinite;
  }
  @keyframes vb-ring {
    0% { opacity: 0.9; transform: scale(1); }
    70%, 100% { opacity: 0; transform: scale(1.32); }
  }
  .vb-face video,
  .vb-face img { width: 100%; height: 100%; object-fit: cover; }
  .vb-face img { width: 60%; height: 60%; border-radius: 8px; opacity: 0.55; }
  .vb-play {
    position: absolute;
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--accent-fill);
    color: #fff;
    font-size: 0.75rem;
    box-shadow: 0 4px 14px rgb(0 0 0 / 0.5);
  }

  .vb-label { display: none; padding-right: 1rem; line-height: 1.25; }
  .vb-label strong { display: block; font-size: 0.9375rem; font-weight: 600; }
  .vb-label span { font-size: 0.8125rem; color: var(--text-tertiary); }

  .vb-dismiss {
    position: absolute;
    top: -8px;
    right: -6px;
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border: 1px solid var(--border-strong);
    border-radius: 50%;
    background: var(--bg-elevated);
    color: var(--text-secondary);
    font-size: 0.75rem;
    opacity: 0;
    transition: opacity 0.2s;
  }
  .vb:hover .vb-dismiss,
  .vb-dismiss:focus-visible { opacity: 1; }
  @media (hover: none) { .vb-dismiss { opacity: 1; } }
  /* O rótulo aparece na chegada e recolhe depois, para o balão ocupar só o círculo. */
  @media (min-width: 640px) {
    .vb-label { display: block; }
    .vb.is-compact:not(:hover):not(:focus-within) .vb-label { display: none; }
  }

  .vb-dialog {
    width: min(100% - 2rem, 62rem);
    max-height: calc(100dvh - 2rem);
    padding: 0;
    border: 1px solid var(--border-strong);
    border-radius: var(--r-2xl);
    background: var(--bg-elevated);
    color: var(--text-primary);
    box-shadow: var(--shadow);
    overflow: auto;
  }
  .vb-dialog::backdrop { background: rgb(4 5 6 / 0.82); -webkit-backdrop-filter: blur(8px); backdrop-filter: blur(8px); }
  .vb-dialog[open] { animation: vb-dialog-in 0.5s var(--ease-out); }
  @keyframes vb-dialog-in {
    from { opacity: 0; transform: translateY(24px) scale(0.97); }
  }
  .vb-dialog-inner { display: grid; gap: 1.25rem; padding: clamp(1rem, 3vw, 1.75rem); }
  .vb-dialog header { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; }
  .vb-dialog h2 { font-size: clamp(1.25rem, 2.4vw, 1.75rem); letter-spacing: -0.02em; line-height: 1.15; }
  .vb-close {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin: -0.5rem -0.5rem 0 0;
    border-radius: 50%;
    flex: none;
  }
  .vb-close:hover { background: rgb(255 255 255 / 0.08); }
  .vb-dialog video,
  .vb-placeholder { width: 100%; aspect-ratio: 16 / 9; border-radius: var(--r-xl); background: var(--bg-base); }
  .vb-placeholder {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.6rem;
    padding: 1.5rem;
    border: 1px dashed var(--border-strong);
    text-align: center;
    font-size: 1.125rem;
  }
  .vb-hint { font-size: 0.875rem; color: var(--text-tertiary); }
  .vb-hint code { font-family: var(--font-mono); }
  .vb-dialog footer { display: flex; flex-wrap: wrap; gap: 0.75rem; }
</style>

<script>
  const bubble = document.querySelector<HTMLElement>('[data-vb]');
  const dialog = document.querySelector<HTMLDialogElement>('[data-vb-dialog]');

  if (bubble && dialog) {
    const preview = bubble.querySelector<HTMLVideoElement>('[data-vb-preview]');
    const player = dialog.querySelector<HTMLVideoElement>('[data-vb-player]');
    const DISMISSED = 'secc-video-dismissed';
    const dismissed = () => {
      try {
        return sessionStorage.getItem(DISMISSED) === '1';
      } catch {
        return false;
      }
    };

    // Entra depois que a pessoa já leu o título, para não disputar a primeira impressão.
    const show = () => {
      if (!bubble.hidden || dismissed()) return;
      bubble.hidden = false;
      preview?.play().catch(() => {});
      window.setTimeout(() => bubble.classList.add('is-compact'), 7000);
    };
    const timer = window.setTimeout(show, 3500);
    window.addEventListener(
      'scroll',
      () => {
        if (window.scrollY > 500) {
          window.clearTimeout(timer);
          show();
        }
      },
      { passive: true },
    );

    bubble.querySelector('[data-vb-open]')!.addEventListener('click', () => {
      preview?.pause();
      dialog.showModal();
      player?.play().catch(() => {});
    });
    bubble.querySelector('[data-vb-dismiss]')!.addEventListener('click', () => {
      bubble.hidden = true;
      try {
        sessionStorage.setItem(DISMISSED, '1');
      } catch {
        /* sem armazenamento: some só nesta página */
      }
    });

    dialog.querySelector('[data-vb-close]')!.addEventListener('click', () => dialog.close());
    // Clique fora do conteúdo fecha, como em qualquer lightbox.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
    dialog.addEventListener('close', () => {
      player?.pause();
      preview?.play().catch(() => {});
    });
  }
</script>
