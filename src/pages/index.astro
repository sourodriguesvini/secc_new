---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Tuesday from '../components/Tuesday.astro';
import Runway from '../components/Runway.astro';
import Story from '../components/Story.astro';
import Dissent from '../components/Dissent.astro';
import System from '../components/System.astro';
import Mesa from '../components/Mesa.astro';
import People from '../components/People.astro';
import Plans from '../components/Plans.astro';
import FinalCta from '../components/FinalCta.astro';
import Footer from '../components/Footer.astro';
import VideoBubble from '../components/VideoBubble.astro';
---

<Base
  title="SECC — nenhuma empresa quebra do nada"
  description="A crise avisa, em média, 18 meses antes. A SECC lê os sinais dentro da sua empresa e põe um plano de pé enquanto ainda há caixa e opções."
>
  <Header />
  <main id="conteudo">
    <Hero />
    <Tuesday />
    <Runway />
    <Story />
    <Dissent />
    <System />
    <Mesa />
    <People />
    <Plans />
    <FinalCta />
  </main>
  <Footer />
  <VideoBubble />
</Base>
