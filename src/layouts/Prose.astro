---
// Páginas de texto corrido (políticas), escritas em Markdown.
import Page from './Page.astro';

const { frontmatter } = Astro.props;
---

<Page title={`${frontmatter.title} | SECC`} description={frontmatter.description}>
  <article class="prose-page">
    <div class="container prose">
      <slot />
    </div>
  </article>
</Page>

<style>
  .prose-page { padding-block: clamp(3rem, 7vw, 6rem) clamp(4rem, 8vw, 7rem); }
  .prose { max-width: 46rem; }
  .prose :global(h1) { font-size: clamp(2.25rem, 5vw, 3.75rem); margin-bottom: 1.5rem; }
  .prose :global(h2) { font-size: clamp(1.5rem, 2.6vw, 2rem); letter-spacing: -0.025em; margin: 3rem 0 1rem; padding-top: 1.5rem; border-top: 1px solid var(--border); }
  .prose :global(h3) { margin: 2rem 0 0.6rem; }
  .prose :global(p),
  .prose :global(li) { font-size: 1.0625rem; line-height: 1.65; color: var(--text-secondary); }
  .prose :global(p) { margin-bottom: 1rem; }
  .prose :global(ul) { display: grid; gap: 0.5rem; margin: 0 0 1.25rem; padding-left: 1.25rem; list-style: disc; }
  .prose :global(li::marker) { color: var(--accent); }
  .prose :global(a) { color: var(--accent); text-underline-offset: 3px; }
  .prose :global(strong) { color: var(--text-primary); font-weight: 600; }
</style>
